#include <windows.h>
#include "resource.h"
#pragma code_page(65001)

1 RT_MANIFEST "@SERIALCTL_MANIFEST_PATH@"
IDI_APP_ICON ICON "@SERIALCTL_ICON_PATH@"
IDI_APP_ICON_LIGHT ICON "@SERIALCTL_LIGHT_ICON_PATH@"

IDD_CONNECTION DIALOGEX 0, 0, 262, 184
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新建连接"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "串口", IDC_SERIAL_LABEL, 12, 10, 64, 10
    COMBOBOX IDC_SERIAL, 12, 22, 146, 88, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    CONTROL "刷新", IDC_SERIAL_REFRESH, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 126, 22, 32, 14
    LTEXT "波特率", IDC_BAUD_LABEL, 170, 10, 64, 10
    COMBOBOX IDC_BAUD, 170, 22, 80, 88, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "数据位", IDC_DATABITS_LABEL, 12, 52, 64, 10
    COMBOBOX IDC_DATABITS, 12, 64, 112, 82, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "校验", IDC_PARITY_LABEL, 138, 52, 64, 10
    COMBOBOX IDC_PARITY, 138, 64, 112, 82, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "停止位", IDC_STOPBITS_LABEL, 12, 94, 64, 10
    COMBOBOX IDC_STOPBITS, 12, 106, 112, 82, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "流控", IDC_FLOW_LABEL, 138, 94, 64, 10
    COMBOBOX IDC_FLOW, 138, 106, 112, 82, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "共享端口", IDC_SHARE_LABEL, 12, 136, 80, 10
    EDITTEXT IDC_SHARE_PORT, 12, 148, 238, 20, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "主机", IDC_HOST_LABEL, 12, 10, 64, 10
    EDITTEXT IDC_HOST, 12, 22, 162, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "端口", IDC_PORT_LABEL, 186, 10, 64, 10
    EDITTEXT IDC_PORT, 186, 22, 64, 20, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "用户名", IDC_USER_LABEL, 12, 52, 64, 10
    EDITTEXT IDC_USER, 12, 64, 112, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "密码", IDC_PASSWORD_LABEL, 138, 52, 64, 10
    EDITTEXT IDC_PASSWORD, 138, 64, 112, 20, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "连接信息仅用于当前会话。", IDC_DIALOG_NOTE, 12, 136, 238, 14
    LTEXT "", IDC_DIALOG_ERROR, 12, 150, 238, 12
    CONTROL "连接", IDOK, "BUTTON", BS_OWNERDRAW | BS_DEFPUSHBUTTON | WS_TABSTOP, 174, 154, 76, 18
    CONTROL "取消", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 90, 154, 76, 18
END

IDD_COMMAND DIALOGEX 0, 0, 238, 136
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "添加常用命令"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称（可选）", -1, 12, 10, 90, 10
    EDITTEXT IDC_COMMAND_NAME, 12, 22, 214, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "指令", -1, 12, 46, 64, 10
    EDITTEXT IDC_COMMAND_TEXT, 12, 58, 174, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "删除", IDC_COMMAND_REMOVE_BASE, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 194, 58, 32, 14
    CONTROL "添加指令", IDC_COMMAND_ADD_STEP, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 12, 76, 72, 14
    LTEXT "指令间隔（毫秒）", IDC_COMMAND_INTERVAL_LABEL, 12, 98, 100, 10
    EDITTEXT IDC_COMMAND_INTERVAL, 12, 110, 214, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_COMMAND_ERROR, 12, 98, 214, 10
    CONTROL "取消", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 82, 110, 68, 18
    CONTROL "确定", IDOK, "BUTTON", BS_OWNERDRAW | BS_DEFPUSHBUTTON | WS_TABSTOP, 158, 110, 68, 18
END

IDD_SFTP_INPUT DIALOGEX 0, 0, 238, 104
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP 操作"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称", IDC_SFTP_INPUT_LABEL, 12, 10, 214, 10
    EDITTEXT IDC_SFTP_INPUT, 12, 22, 214, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_SFTP_INPUT_ERROR, 12, 48, 214, 10
    CONTROL "取消", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 82, 70, 68, 18
    CONTROL "确定", IDOK, "BUTTON", BS_OWNERDRAW | BS_DEFPUSHBUTTON | WS_TABSTOP, 158, 70, 68, 18
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SERIALCTL_FILE_VERSION_COMMA@
 PRODUCTVERSION @SERIALCTL_FILE_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "SerialCtl\0"
            VALUE "FileDescription", "SerialCtl C++ for Windows 7\0"
            VALUE "FileVersion", "@SERIALCTL_SEMVER@\0"
            VALUE "InternalName", "serialctl.exe\0"
            VALUE "OriginalFilename", "serialctl.exe\0"
            VALUE "ProductName", "SerialCtl\0"
            VALUE "ProductVersion", "@SERIALCTL_SEMVER@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
