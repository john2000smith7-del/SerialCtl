+    if (serialctl_resize_event != INVALID_HANDLE_VALUE && serialctl_resize) {
+        serialctl_extra_handles[0] = serialctl_resize_event;
+        *extra_handles = serialctl_extra_handles;
+        *n_extra_handles = 1;
+    }
+
     return true;
 }
 
 static bool plink_mainloop_post(void *vctx, size_t extra_handle_index)
 {
+    if (serialctl_resize_event != INVALID_HANDLE_VALUE && serialctl_resize &&
+        extra_handle_index == 0) {
+        /* The event wait provides the synchronization point. Read the
+         * read-only mapping directly: InterlockedCompareExchange performs a
+         * write cycle even when used as a load and would fault here. */
+        LONG columns = serialctl_resize->columns;
+        LONG rows = serialctl_resize->rows;
+        if (columns > 0 && rows > 0)
+            backend_size(backend, columns, rows);
+    }
+
     if (sending)
         handle_unthrottle(stdin_handle, backend_sendbuffer(backend));
 
