+/*
+ * SerialCtl embeds Plink behind pipes, so Plink cannot discover the host
+ * window size through a console. The parent passes an inheritable event and
+ * shared mapping containing the latest character-cell dimensions.
+ */
+struct serialctl_resize_state {
+    volatile LONG columns;
+    volatile LONG rows;
+};
+static HANDLE serialctl_resize_event = INVALID_HANDLE_VALUE;
+static HANDLE serialctl_resize_mapping = NULL;
+static struct serialctl_resize_state *serialctl_resize = NULL;
+static HANDLE serialctl_extra_handles[1];
