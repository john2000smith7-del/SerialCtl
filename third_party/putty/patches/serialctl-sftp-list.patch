+               name->attrs.flags & SSH_FILEXFER_ATTR_SIZE ? name->attrs.size : 0,
+               name->attrs.flags & SSH_FILEXFER_ATTR_PERMISSIONS ?
+                   name->attrs.permissions : 0,
+               name->attrs.flags & SSH_FILEXFER_ATTR_ACMODTIME ?
+                   name->attrs.mtime : 0);
+        serialctl_print_hex(name->filename);
+        printf("\n");
+        return;
+    }
     with_stripctrl(san, name->longname)
         printf("%s\n", san);
 }
