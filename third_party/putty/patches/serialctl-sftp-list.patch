+static void serialctl_print_hex(const char *value)
+{
+    for (const unsigned char *p = (const unsigned char *)value; *p; ++p)
+        printf("%02X", (unsigned)*p);
+}
+
+static void serialctl_complete_name_attrs(
+    const char *directory, struct fxp_name *name)
+{
+    struct sftp_packet *pktin;
+    struct sftp_request *req;
+    struct fxp_attrs attrs;
+    struct fxp_handle *dirh;
+    const char *slash = directory[strlen(directory) - 1] == '/' ? "" : "/";
+    char *path;
+
+    const unsigned long required = SSH_FILEXFER_ATTR_SIZE |
+        SSH_FILEXFER_ATTR_PERMISSIONS | SSH_FILEXFER_ATTR_ACMODTIME;
+    if ((name->attrs.flags & required) == required)
+        return;
+
+    path = dupcat(directory, slash, name->filename);
+    req = fxp_stat_send(path);
+    pktin = sftp_wait_for_reply(req);
+    if (fxp_stat_recv(pktin, req, &attrs)) {
+        if (!(name->attrs.flags & SSH_FILEXFER_ATTR_SIZE) &&
+            (attrs.flags & SSH_FILEXFER_ATTR_SIZE)) {
+            name->attrs.flags |= SSH_FILEXFER_ATTR_SIZE;
+            name->attrs.size = attrs.size;
+        }
+        if (!(name->attrs.flags & SSH_FILEXFER_ATTR_PERMISSIONS) &&
+            (attrs.flags & SSH_FILEXFER_ATTR_PERMISSIONS)) {
+            name->attrs.flags |= SSH_FILEXFER_ATTR_PERMISSIONS;
+            name->attrs.permissions = attrs.permissions;
+        }
+        if (!(name->attrs.flags & SSH_FILEXFER_ATTR_ACMODTIME) &&
+            (attrs.flags & SSH_FILEXFER_ATTR_ACMODTIME)) {
+            name->attrs.flags |= SSH_FILEXFER_ATTR_ACMODTIME;
+            name->attrs.atime = attrs.atime;
+            name->attrs.mtime = attrs.mtime;
+        }
+    }
+
+    /* Some valid v3 servers omit permissions from both READDIR and STAT.
+     * OPENDIR is an unambiguous fallback for the one fact the UI needs. */
+    if (!(name->attrs.flags & SSH_FILEXFER_ATTR_PERMISSIONS)) {
+        req = fxp_opendir_send(path);
+        pktin = sftp_wait_for_reply(req);
+        dirh = fxp_opendir_recv(pktin, req);
+        if (dirh) {
+            name->attrs.flags |= SSH_FILEXFER_ATTR_PERMISSIONS;
+            name->attrs.permissions = PERMS_DIRECTORY;
+            req = fxp_close_send(dirh);
+            pktin = sftp_wait_for_reply(req);
+            fxp_close_recv(pktin, req);
+        }
+    }
+    sfree(path);
+}
+
 void list_directory_from_sftp_print(struct fxp_name *name)
 {
+    if (serialctl_machine_list) {
+        printf("SERIALCTL_ENTRY\t%lu\t%"PRIu64"\t%lu\t%lu\t",
